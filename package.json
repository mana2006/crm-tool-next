{
  "name": "crm-tool-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "bundle:check": "node scripts/check-bundle.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
